{{ end }}


{{/* Conditional ignores based on OS and setup parameters */}}

{{ if eq .chezmoi.os "darwin" }}
{{ template "synology" }}
{{ end }}

{{ if eq .chezmoi.os "linux" }}
{{ template "macos" }}
{{ end }}

{{ if not (contains "/syno/" (env "PATH")) }}
{{ template "synology" }}
{{ end }}

{{ if or (env "SSH_CLIENT") (env "SSH_TTY") }}
{{ template "apps" }}
{{ end }}

{{ if eq .chezmoi.os "windows" }}
{{ template "darwin" }}
{{ template "synology" }}
.config
{{ end }}
