{{- if (eq .osid "linux-debian") -}}
#!/usr/bin/env bash
set -euo pipefail

# Aptfile hash: {{ include "packages/Aptfile" | sha256sum }}

# Add eza apt source
sudo wget --output-document=/etc/apt/trusted.gpg.d/eza.asc https://raw.githubusercontent.com/eza-community/eza/main/deb.asc
sudo tee /etc/apt/sources.list.d/eza.sources &>/dev/null <<EOF
Types: deb
URIs: http://deb.gierens.de/
Suites: stable
Components: main
Signed-By: /etc/apt/trusted.gpg.d/eza.asc
EOF


# Install packages
sudo apt-get install -y apt-transport-https
sudo apt-get update
grep -v '^#' {{ .chezmoi.sourceDir }}/packages/Aptfile | xargs sudo apt-get install -y


# Install git-delta (git diff syntax highlighter)
(
version="$(curl --silent "https://api.github.com/repos/dandavison/delta/releases/latest" | jq -r ".tag_name")"
url="https://github.com/dandavison/delta/releases/download/${version}/git-delta_${version}_$(dpkg --print-architecture).deb"
wget -nc "$url"
filename="$(basename "$url")"
sudo dpkg -i "$filename"
rm "$filename" || true
)


